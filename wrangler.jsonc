{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sog-moderator-portal",
  "main": "src/index.js",
  "compatibility_date": "2026-10-28",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sog-moderator-portal",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ],
  "observability": {
    "enabled": true
  }
}
